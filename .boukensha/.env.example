# Copy to .env and fill in. The real .env is gitignored, never commit it.

# Provider API key: set the one your task's provider uses.
# Local Ollama needs none. OLLAMA_API_KEY is for ollama_cloud.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_API_KEY=

# MUD credentials. Host, port, characters, and secret variable names live in
# settings.yaml. The administrator secret is used only by a one-shot reset
# child. Add one variable per additional configured player profile.
MUD_PASSWORD=
MUD_ADMIN_PASSWORD=
# MUD_PASSWORD_TESTER=

# A player password may instead live in profiles/<profile-id>/.env under the
# password_env name configured for that profile. Provider and administrator
# secrets remain in this shared file.

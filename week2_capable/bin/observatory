#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "$0")/../.." && pwd)"
web_dist="$project_root/week2_capable/observatory/web/dist"

if [[ ! -f "$web_dist/index.html" ]]; then
  printf '%s\n' \
    "Observatory is not built." \
    "Run: cd $project_root/week2_capable/observatory/web && npm run build" >&2
  exit 1
fi

export OBSERVATORY_PROJECT_ROOT="$project_root"
export OBSERVATORY_REVISION="$(
  git -C "$project_root" rev-parse --short=12 HEAD 2>/dev/null || printf unknown
)"
export OBSERVATORY_WEB_DIST="$web_dist"
cd "$project_root/week2_capable"
exec uv run --package boukensha-observatory observatory "$@"

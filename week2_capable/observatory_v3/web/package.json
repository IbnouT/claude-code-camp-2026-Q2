{
  "name": "observatory_v3",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run bundle:check",
    "bundle:check": "node scripts/check-production-bundle.mjs",
    "check": "npm run runtime:check && npm run contracts:check && npm run format:check && npm run typecheck && npm run lint && npm run architecture:check && npm run test && npm run build && npm run test:e2e && npm run hmr:check",
    "contracts:generate": "orval --config orval.config.ts",
    "contracts:check": "node scripts/check-contract-generation.mjs && node scripts/check-contract-coverage.mjs",
    "architecture:check": "node scripts/check-architecture.mjs && node --test scripts/check-architecture.test.mjs",
    "lint": "oxlint --deny-warnings --react-plugin --jsx-a11y-plugin --vitest-plugin --import-plugin .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hmr:check": "node scripts/check-hmr.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --pretty false",
    "runtime:check": "node scripts/check-runtime.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/geist": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.16.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@tanstack/router-plugin": "1.168.23",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "orval": "8.23.0",
    "oxlint": "1.76.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "esbuild@0.28.1": true
  }
}

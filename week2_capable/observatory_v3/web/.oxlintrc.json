{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "plugins": ["react", "jsx-a11y", "vitest", "import"],
  "rules": {
    "import/no-unassigned-import": "off",
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": ["src/data/message-command.ts"],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["src/features/live/message-agent-dialog.tsx"],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off",
        "react/no-array-index-key": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
    "storybook-static/**",
    "src/routeTree.gen.ts",
    "src/data/generated/**"
  ]
}

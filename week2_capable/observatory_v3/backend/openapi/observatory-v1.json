{
  "components": {
    "schemas": {
      "ApiError": {
        "additionalProperties": false,
        "description": "One stable machine-readable API failure.",
        "properties": {
          "contract_version": {
            "const": "v1",
            "default": "v1",
            "title": "Contract Version",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Detail"
          },
          "error": {
            "minLength": 1,
            "title": "Error",
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "title": "ApiError",
        "type": "object"
      },
      "CommandAccepted": {
        "additionalProperties": false,
        "description": "Future durable acknowledgement for one accepted session command.",
        "properties": {
          "command_id": {
            "minLength": 1,
            "title": "Command Id",
            "type": "string"
          },
          "request_id": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Request Id",
            "type": "string"
          },
          "resource_id": {
            "minLength": 1,
            "title": "Resource Id",
            "type": "string"
          },
          "state": {
            "const": "queued",
            "default": "queued",
            "title": "State",
            "type": "string"
          },
          "submitted_at": {
            "minLength": 1,
            "title": "Submitted At",
            "type": "string"
          }
        },
        "required": [
          "command_id",
          "request_id",
          "resource_id",
          "submitted_at"
        ],
        "title": "CommandAccepted",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "Current API health and authority split.",
        "properties": {
          "control_plane": {
            "const": "authenticated_local",
            "title": "Control Plane",
            "type": "string"
          },
          "evidence_plane": {
            "const": "read_only",
            "title": "Evidence Plane",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "evidence_plane",
          "control_plane"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LiveVoiceCapability": {
        "additionalProperties": false,
        "description": "Availability of cost-bearing speech for the selected Live thought.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "endpoint_template": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Endpoint Template"
          },
          "max_characters": {
            "default": 400,
            "title": "Max Characters",
            "type": "integer"
          }
        },
        "required": [
          "enabled",
          "detail"
        ],
        "title": "LiveVoiceCapability",
        "type": "object"
      },
      "ObservatoryCapabilities": {
        "additionalProperties": false,
        "description": "The exact sources and features available to this installation.",
        "properties": {
          "features": {
            "items": {
              "type": "string"
            },
            "title": "Features",
            "type": "array"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceStatus"
            },
            "title": "Sources",
            "type": "array"
          },
          "version": {
            "default": 1,
            "title": "Version",
            "type": "integer"
          },
          "voice": {
            "$ref": "#/components/schemas/LiveVoiceCapability"
          }
        },
        "required": [
          "sources",
          "features",
          "voice"
        ],
        "title": "ObservatoryCapabilities",
        "type": "object"
      },
      "PlayerOption": {
        "additionalProperties": false,
        "description": "One player represented in the session catalog.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label"
        ],
        "title": "PlayerOption",
        "type": "object"
      },
      "ResourceChangedNotification": {
        "additionalProperties": false,
        "description": "One notification that identifies a bounded resource to refetch.",
        "properties": {
          "at": {
            "title": "At",
            "type": "number"
          },
          "contract_version": {
            "const": "v1",
            "default": "v1",
            "title": "Contract Version",
            "type": "string"
          },
          "event": {
            "const": "resource_changed",
            "default": "resource_changed",
            "title": "Event",
            "type": "string"
          },
          "resource_id": {
            "minLength": 1,
            "title": "Resource Id",
            "type": "string"
          },
          "resource_kind": {
            "minLength": 1,
            "title": "Resource Kind",
            "type": "string"
          },
          "resource_version": {
            "minimum": 1,
            "title": "Resource Version",
            "type": "integer"
          },
          "source_cursor": {
            "minLength": 1,
            "title": "Source Cursor",
            "type": "string"
          }
        },
        "required": [
          "resource_kind",
          "resource_id",
          "resource_version",
          "source_cursor",
          "at"
        ],
        "title": "ResourceChangedNotification",
        "type": "object"
      },
      "SessionCatalogItem": {
        "additionalProperties": false,
        "description": "One launcher session without loading its retained evidence.",
        "properties": {
          "capture_status": {
            "title": "Capture Status",
            "type": "string"
          },
          "character": {
            "title": "Character",
            "type": "string"
          },
          "control_available": {
            "title": "Control Available",
            "type": "boolean"
          },
          "control_state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Control State"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "ended_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ended At"
          },
          "event_count": {
            "minimum": 0,
            "title": "Event Count",
            "type": "integer"
          },
          "gateway_session_id": {
            "title": "Gateway Session Id",
            "type": "string"
          },
          "goal_count": {
            "default": 0,
            "minimum": 0,
            "title": "Goal Count",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "latest_seq": {
            "minimum": 0,
            "title": "Latest Seq",
            "type": "integer"
          },
          "legacy": {
            "title": "Legacy",
            "type": "boolean"
          },
          "live": {
            "title": "Live",
            "type": "boolean"
          },
          "nudge_count": {
            "default": 0,
            "minimum": 0,
            "title": "Nudge Count",
            "type": "integer"
          },
          "objective": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Objective"
          },
          "player_id": {
            "title": "Player Id",
            "type": "string"
          },
          "state": {
            "title": "State",
            "type": "string"
          },
          "stop_mode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Stop Mode"
          },
          "updated_at": {
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "player_id",
          "character",
          "gateway_session_id",
          "state",
          "control_state",
          "control_available",
          "capture_status",
          "created_at",
          "updated_at",
          "ended_at",
          "event_count",
          "latest_seq",
          "legacy",
          "live"
        ],
        "title": "SessionCatalogItem",
        "type": "object"
      },
      "SessionCatalogResponse": {
        "additionalProperties": false,
        "description": "Future bounded session discovery page.",
        "properties": {
          "capture_gaps": {
            "items": {
              "type": "string"
            },
            "maxItems": 32,
            "title": "Capture Gaps",
            "type": "array"
          },
          "completeness": {
            "enum": [
              "complete",
              "partial",
              "degraded"
            ],
            "title": "Completeness",
            "type": "string"
          },
          "continuation_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Continuation Cursor"
          },
          "players": {
            "items": {
              "$ref": "#/components/schemas/PlayerOption"
            },
            "maxItems": 50,
            "title": "Players",
            "type": "array"
          },
          "resource_id": {
            "const": "session-catalog",
            "default": "session-catalog",
            "title": "Resource Id",
            "type": "string"
          },
          "resource_version": {
            "const": 1,
            "default": 1,
            "title": "Resource Version",
            "type": "integer"
          },
          "sessions": {
            "items": {
              "$ref": "#/components/schemas/SessionCatalogItem"
            },
            "maxItems": 50,
            "title": "Sessions",
            "type": "array"
          },
          "source_cursor": {
            "minLength": 1,
            "title": "Source Cursor",
            "type": "string"
          },
          "source_refs": {
            "items": {
              "type": "string"
            },
            "maxItems": 16,
            "title": "Source Refs",
            "type": "array"
          }
        },
        "required": [
          "source_cursor",
          "completeness",
          "continuation_cursor",
          "capture_gaps",
          "source_refs",
          "players",
          "sessions"
        ],
        "title": "SessionCatalogResponse",
        "type": "object"
      },
      "SessionCommandRequest": {
        "additionalProperties": false,
        "description": "Future optimistic command against one exact session cursor.",
        "properties": {
          "action": {
            "enum": [
              "guide",
              "revise",
              "pause",
              "resume",
              "stop"
            ],
            "title": "Action",
            "type": "string"
          },
          "expected_cursor": {
            "minLength": 1,
            "title": "Expected Cursor",
            "type": "string"
          },
          "instruction": {
            "anyOf": [
              {
                "maxLength": 4000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Instruction"
          },
          "request_id": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "action",
          "expected_cursor"
        ],
        "title": "SessionCommandRequest",
        "type": "object"
      },
      "SourceStatus": {
        "additionalProperties": false,
        "description": "One evidence source and its current availability.",
        "properties": {
          "contract_digest": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Contract Digest"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "id": {
            "enum": [
              "gateway",
              "agent",
              "benchmark",
              "knowledge",
              "world"
            ],
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "state": {
            "enum": [
              "ready",
              "unavailable",
              "disabled"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "state",
          "detail"
        ],
        "title": "SourceStatus",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Versioned local contracts for Live, Sessions, Experiments, Knowledge, and evidence queries.",
    "title": "Boukensha Observatory API",
    "version": "1.0.0"
  },
  "openapi": "3.1.1",
  "paths": {
    "/api/v1/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservatoryCapabilities"
                }
              }
            },
            "description": "Successful response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Resource not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Request validation failed"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Required source unavailable"
          }
        },
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Resource not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Request validation failed"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Required source unavailable"
          }
        },
        "tags": [
          "system"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ]
}

[
  {
    "description": "Look at the current room or at a specific target. Call with NO arguments to describe the current room (do NOT pass target: 'room'). Pass a target to inspect a specific item, mob, or player. Use preposition 'in' to look inside a container, 'at' to inspect, or a direction to peek into an adjacent room.",
    "inputSchema": {
      "properties": {
        "preposition": {
          "description": "Preposition or direction to look through.",
          "enum": [
            "in",
            "at",
            "north",
            "east",
            "south",
            "west",
            "up",
            "down"
          ],
          "type": "string"
        },
        "target": {
          "description": "Item, mob, or player to inspect. Omit to describe the current room.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "look"
  },
